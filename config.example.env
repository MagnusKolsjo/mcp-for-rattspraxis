# ===========================================================================
# Konfiguration — rättspraxis MCP-server
# ===========================================================================

# ---------------------------------------------------------------------------
# Databas
# ---------------------------------------------------------------------------

# PostgreSQL (krävs för sok_i_domtext med fulltext-sökning och relevansrankning)
DATABASE_URL=postgresql://<DB_ANVANDARE>:<DB_LOSENORD>@localhost:5432/<DB_NAMN>

# SQLite (sok_i_domtext fungerar men med enklare LIKE-sökning utan relevansrankning)
# DATABASE_URL=sqlite:///<DB_SOKVÄG>

# ---------------------------------------------------------------------------
# Cache-TTL
# ---------------------------------------------------------------------------

PDF_CACHE_TTL_DAGAR=90
METADATA_CACHE_TTL_DAGAR=30

# ---------------------------------------------------------------------------
# MCP-transport
# ---------------------------------------------------------------------------

# stdio — för lokal MCP-klient (t.ex. Claude Desktop)
# http  — för hostad driftsättning
MCP_TRANSPORT=stdio

# ---------------------------------------------------------------------------
# HTTP-läge (används bara om MCP_TRANSPORT=http)
# ---------------------------------------------------------------------------

# MCP_HOST=127.0.0.1
# MCP_PORT=8005

# Obligatorisk i http-läget: utan nyckel startar servern inte (exitkod 2).
# Generera med: python3 -c "import secrets; print(secrets.token_hex(32))"
# MCP_API_KEY=

# ---------------------------------------------------------------------------
# Daglig synk (01_synka_publiceringar.py via synk_daglig.sh)
# ---------------------------------------------------------------------------

# Schemaläggare: launchd (macOS; kör även om datorn sov vid schemalagd tid)
# eller cron (Linux och macOS).
SCHEMALAGGARE=launchd

# Tidpunkt i cron-format (minut timme * * *). Kör du flera synkar, sprid
# dem mellan 03:00 och 06:00.
CRON_SCHEMA="15 4 * * *"

# Paus mellan sidanropen mot Domstolsverket, i sekunder.
RP_SYNK_PAUS_SEKUNDER=2

# Paus mellan PDF-hämtningarna i synkens PDF-steg, i sekunder.
RP_SYNK_PDF_PAUS_SEKUNDER=2

# sok_i_domtext räknas som heltäckande bara om den senaste lyckade synken
# är högst så här många dagar gammal.
RP_TACKNING_MAX_DAGAR=3

# Python-tolk för launchd/cron. Lämna tom för .venv/bin/python3 i servermappen.
# PYTHON_SOKVAG=/<SOKVAG_TILL_VENV>/bin/python3

# Antal dagar att behålla synkloggarna i logs/.
LOGGRADER_BEHALL_DAGAR=30

# ---------------------------------------------------------------------------
# PDF-extraktion (pdftext_skydd.py, används av hamta_pdf och PDF-steget i synken)
# ---------------------------------------------------------------------------

# Tesseract-språk för OCR av PDF-sidor utan textlager. Sätts uttryckligen
# eftersom pymupdf4llm annars OCR:ar på engelska.
# RP_OCR_SPRAK=swe+eng

# Minnesgräns (RSS) i MB för en extraktionsprocess. Ett sidblock som
# passerar gränsen avbryts och läses i stället med ren textutvinning.
# RP_PDF_MAX_MINNE_MB=3000

# Tidsgräns i sekunder per sidblock, med samma reserv som minnesgränsen.
# RP_PDF_TIDSGRANS_S=300

# Antal sidor per block. Extraktionen körs blockvis i en egen process, så
# att ett enskilt dokument aldrig kan dra hela minnesgränsen på en gång.
# RP_PDF_SIDBLOCK=20

# Mapp för OCR-kön (RP_OCR_KO_MAPP/ko.jsonl + RP_OCR_KO_MAPP/filer/) med
# dokument där en sida saknade textlager eller ett block lästes med ren
# textutvinning. Standard är ocr_ko/ bredvid pdftext_skydd.py.
# RP_OCR_KO_MAPP=ocr_ko
