# PostgreSQL (rekommenderas — krävs för sok_i_domtext med fulltext-sökning)
DATABASE_URL=postgresql://mitt_db_anvandare:byt_till_eget_starkt_losenord@localhost:5432/riksdag

# SQLite (fallback — sok_i_domtext fungerar men med enklare LIKE-sökning)
# DATABASE_URL=sqlite:///rattspraxis_cache.db

# Cache-TTL
PDF_CACHE_TTL_DAGAR=90
METADATA_CACHE_TTL_DAGAR=30

# MCP-transport: stdio (standard för lokal MCP-klient) eller http (hostad driftsättning)
MCP_TRANSPORT=stdio

# HTTP-läge (används bara om MCP_TRANSPORT=http)
# MCP_HOST=127.0.0.1
# MCP_PORT=8005
# MCP_API_KEY=genereras-med-secrets.token_hex(32)
